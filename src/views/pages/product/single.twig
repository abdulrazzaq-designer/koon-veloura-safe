<style id="veloura-product-data-v98-critical">
  /* Availability pulse */
  .veloura-product-page .veloura-product-stock-radar {
    overflow: visible !important;
  }

  .veloura-product-page .veloura-product-stock-radar__dot {
    display: inline-block !important;
    width: 9px !important;
    height: 9px !important;
    min-width: 9px !important;
    min-height: 9px !important;
    flex: 0 0 9px !important;
    border-radius: 9999px !important;
    background: #22c55e !important;
    opacity: 1 !important;
  }

  .veloura-product-page
  .veloura-product-stock-radar.is-pulse
  .veloura-product-stock-radar__dot {
    animation: veloura-stock-pulse 1.55s ease-out infinite !important;
  }

  @keyframes veloura-stock-pulse {
    0% { box-shadow: 0 0 0 0 rgba(34,197,94,.58); }
    70% { box-shadow: 0 0 0 9px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
  }

  /* Product option fields: the outer options card uses secondary background;
     the actual controls use the PAGE background, same visual hierarchy in
     Light and Dark. */
  .veloura-product-page .s-product-options-option :is(
    .s-select,
    .s-select-control,
    select,
    input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]),
    textarea,
    .s-form-control,
    .form-input
  ) {
    background: var(--veloura-product-bg-inline, #ffffff) !important;
    background-color: var(--veloura-product-bg-inline, #ffffff) !important;
    color: inherit !important;
    box-shadow: none !important;
  }

  html.dark .veloura-product-page .s-product-options-option :is(
    .s-select,
    .s-select-control,
    select,
    input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]),
    textarea,
    .s-form-control,
    .form-input
  ),
  body.dark .veloura-product-page .s-product-options-option :is(
    .s-select,
    .s-select-control,
    select,
    input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]),
    textarea,
    .s-form-control,
    .form-input
  ) {
    background: var(--veloura-product-dark-bg-inline, var(--veloura-dark-body-bg, #010202)) !important;
    background-color: var(--veloura-product-dark-bg-inline, var(--veloura-dark-body-bg, #010202)) !important;
    color: var(--veloura-dark-primary-text, #ffffff) !important;
    -webkit-text-fill-color: currentColor !important;
    border-color: rgba(255,255,255,.10) !important;
    box-shadow: none !important;
  }

  /* Read-more: retain the background-colored separation ring as a real border,
     but remove EVERY shadow. */
  .veloura-product-page #btn-show-more.veloura-product-read-more,
  .veloura-product-page #btn-show-more.veloura-product-read-more:hover,
  .veloura-product-page #btn-show-more.veloura-product-read-more:focus,
  .veloura-product-page #btn-show-more.veloura-product-read-more:active,
  .veloura-product-page #btn-show-more.veloura-product-read-more.is-expanded {
    border: 7px solid var(--veloura-product-bg-inline, #ffffff) !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  html.dark .veloura-product-page #btn-show-more.veloura-product-read-more,
  body.dark .veloura-product-page #btn-show-more.veloura-product-read-more,
  html.dark .veloura-product-page #btn-show-more.veloura-product-read-more:hover,
  body.dark .veloura-product-page #btn-show-more.veloura-product-read-more:hover,
  html.dark .veloura-product-page #btn-show-more.veloura-product-read-more:focus,
  body.dark .veloura-product-page #btn-show-more.veloura-product-read-more:focus,
  html.dark .veloura-product-page #btn-show-more.veloura-product-read-more:active,
  body.dark .veloura-product-page #btn-show-more.veloura-product-read-more:active,
  html.dark .veloura-product-page #btn-show-more.veloura-product-read-more.is-expanded,
  body.dark .veloura-product-page #btn-show-more.veloura-product-read-more.is-expanded {
    border-color: var(--veloura-product-dark-bg-inline, var(--veloura-dark-body-bg, #010202)) !important;
    box-shadow: none !important;
  }

  /* Sticky OFF = normal rounded purchase card. */
  @media (max-width: 767px) {
    .veloura-product-page.veloura-product-mobile-sticky-disabled
    .sticky-product-bar.veloura-product-sticky-bar {
      position: static !important;
      inset: auto !important;
      width: 100% !important;
      margin: 16px 0 0 !important;
      border-radius: var(--veloura-product-radius, 28px) !important;
      overflow: visible !important;
    }

    .veloura-product-page.veloura-product-mobile-sticky-disabled
    .sticky-product-bar.veloura-product-sticky-bar::after {
      content: none !important;
      display: none !important;
    }
  }

  .veloura-product-page.veloura-product-tags-visual-hidden .veloura-product-tags {
    display: none !important;
  }

  /* Related-products settings that do not depend on component internals. */
  .veloura-product-related-products.is-title-centered .veloura-product-related-heading,
  .veloura-product-related-products.is-title-centered .veloura-product-related-title {
    width: 100% !important;
    text-align: center !important;
    justify-content: center !important;
    margin-inline: auto !important;
  }

  .veloura-product-related-products.is-arrows-hidden :is(
    .s-slider-next,
    .s-slider-prev,
    .swiper-button-next,
    .swiper-button-prev,
    [part~="next"],
    [part~="prev"]
  ) {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>
{# VELOURA PRODUCT DATA V98 CRITICAL END #}

<div
  data-veloura-recovered="true"
  data-veloura-product-data-build="v98"
  data-v42-order-enabled="{{ vpp_details_order_enabled ? 'true' : 'false' }}"
  data-v96-stock-pulse="{{ vpp_show_stock_radar ? 'true' : 'false' }}"
  data-v42-order-title="{{ vpp_order_title }}"
  data-v42-order-price="{{ vpp_order_price }}"
  data-v42-order-status="{{ vpp_order_status }}"
  data-v42-order-description="{{ vpp_order_description }}"
  data-v42-order-data="{{ vpp_order_data }}"
  data-v42-order-extras="{{ vpp_order_extras }}"
  data-v42-order-options="{{ vpp_order_options }}"
  data-v42-order-quick="{{ vpp_order_quick }}"
  data-v42-order-payments="{{ vpp_order_payments }}"
  data-veloura-sticky="{{ vpp_mobile_sticky_cart ? 'true' : 'false' }}"
     data-veloura-product-build="v100-native-related-recent" data-veloura-stock-radar="{{ vpp_show_stock_radar ? 'pulse' : 'simple' }}" data-veloura-images-zoom="{{ vpp_images_zoom ? 'true' : 'false' }}" data-veloura-quantity-style="{{ vpp_mobile_quantity_style }}" class="container veloura-product-page {{ vpp_enabled ? 'veloura-product-enabled' : '' }} {{ vpp_hide_breadcrumb ? 'veloura-product-hide-breadcrumb' : '' }} {{ vpp_hide_thumbnails ? 'veloura-product-hide-thumbs' : '' }} veloura-product-images-{{ vpp_images_height_mode }} {{ vpp_images_zoom ? 'veloura-product-zoom-enabled' : '' }} {{ vpp_enabled and vpp_hide_short_description ? 'veloura-product-desc-collapsed' : '' }} {{ vpp_mobile_sticky_cart ? 'veloura-product-mobile-sticky-enabled' : 'veloura-product-mobile-sticky-disabled' }} {{ vpp_mobile_sticky_price ? 'veloura-product-mobile-sticky-price' : '' }} veloura-product-qty-{{ vpp_mobile_quantity_style }} {{ vpp_mobile_buttons_compact ? 'veloura-product-buttons-compact' : '' }} {{ vpp_hide_discount_value ? 'veloura-product-hide-discount' : '' }} {{ vpp_hide_tags_visual_only ? 'veloura-product-tags-visual-hidden' : '' }}" style="--veloura-product-bg-inline: {{ vpp_basic_bg }}; --veloura-product-secondary-bg-inline: {{ vpp_second_bg }}; --veloura-product-dark-bg-inline: {{ vpp_dark_basic_bg }}; --veloura-product-dark-secondary-bg-inline: {{ vpp_dark_second_bg }}; --veloura-product-radius: {{ vpp_general_radius }};" >

        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        {% if not (vpp_enabled and vpp_hide_breadcrumb) %}
            <nav class="breadcrumbs w-full py-5 veloura-product-breadcrumb">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        {% endif %}
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            <div class="sidebar md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 pb-8 md:pb-16 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        type="thumbs"
                        loop="false"
                        {{ vpp_images_height_mode == 'fixed_all' ? '' : 'auto-height' }}
                        listen-to-thumbnails-option
                thumbs-config='{
                  "slidesPerView": 4,
                  "slidesPerGroup": 1,
                  "spaceBetween": 10,
                  "freeMode": true,
                  "watchSlidesProgress": true,
                  "allowTouchMove": true,
                  "roundLengths": true,
                  "breakpoints": {
                    "768": {"slidesPerView": 5, "slidesPerGroup": 1, "spaceBetween": 12}
                  }
                }'
                show-thumbs-controls="false">
                    <div class="veloura-product-media-actions">
                        <div class="veloura-product-media-actions__left">
                            <button type="button"
                                    class="veloura-product-media-action-btn veloura-product-media-wishlist"
                                    data-id="{{ product.id }}"
                                    onclick="salla.wishlist.toggle('{{ product.id }}')"
                                    aria-label="add to wishlist">
                                <i class="sicon-heart"></i>
                            </button>

                            <salla-social-share
                                    class="veloura-product-media-action-btn veloura-product-media-share"
                                    aria-label="social share">
                            </salla-social-share>
                        </div>

                        {% if product.promotion_title %}
                            <div class="promotion-title veloura-product-media-promo">{{ product.promotion_title }}</div>
                        {% endif %}
                    </div>

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images and not (vpp_enabled and vpp_hide_thumbnails) %}
                        <div slot="thumbs" class="veloura-product-native-thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth veloura-product-thumb-item {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    {% if loop.index < 5 %}
                                        <img src="{{ image.url }}"
                                             loading="eager"
                                             class="object-contain w-full h-full bg-gray-100 overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% else %}
                                        <img src="{{ image.url }}"
                                             loading="lazy"
                                             class="object-contain w-full h-full bg-gray-100 overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            <div class="main-content md:sticky md:overflow-hidden top-24 w-full md:w-2/4 md:pb-16">

                <div class="veloura-product-order-hook" data-v42-group="title">
                    {% hook 'product:single.description.start' %}
                </div>

                {% if product.brand and product.brand.name and (not vpp_enabled or vpp_show_brand) %}
                    <div class="product-brand veloura-product-brand mb-5" data-v42-group="title">
                        {% if not vpp_brand_title_image_only %}
                            <span class="veloura-product-brand__label">{{ vpp_brand_label }}</span>
                        {% endif %}
                        <a class="brand-logo veloura-product-brand__logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            {% if product.brand.logo %}
                                <img width="100%" height="100%" class="max-h-full object-contain"
                                     src="{{ product.brand.logo }}"
                                     title="{{ product.brand.name }}"
                                     alt="{{ product.brand.name }}">
                            {% endif %}
                            <span class="veloura-product-brand__name">{{ product.brand.name }}</span>
                        </a>
                    </div>
                {% endif %}

                <h1 class="text-xl md:text-2xl leading-10 font-bold mb-6 text-gray-800" data-v42-group="title">{{ product.name }}</h1>

                {% if vpp_enabled and vpp_show_category and product.category and product.category.name %}
                    <div class="veloura-product-category-under-title" data-v42-group="title">
                        <span>{{ vpp_category_label }}</span>
                        <a href="{{ product.category.url }}">{{ product.category.name }}</a>
                    </div>
                {% endif %}

                {% if product.subtitle and not (vpp_enabled and vpp_hide_short_description) %}
                    <h2 class="product-entry__sub-title text-sm text-gray-500 leading-6 mb-2.5" data-v42-group="title">
                        {{ product.subtitle }}
                    </h2>
                {% endif %}


                {# One canonical live price directly under the product title/subtitle #}
                <div class="veloura-product-header-price" data-v42-group="price">
                    <div class="price-wrapper" data-veloura-single-price>
                        {% if product.starting_price and not product.is_on_sale %}
                            <span class="starting-price-title">{{ trans('pages.products.starting_price') }}</span>
                        {% endif %}

                        <h2 class="total-price">
                            {{ product.is_on_sale
                                ? product.sale_price|money
                                : (product.starting_price ? product.starting_price|money : product.price|money) }}
                        </h2>

                        <span class="before-price {{ product.is_on_sale ? '' : 'hidden' }}">
                            {{ product.regular_price|money }}
                        </span>
                    </div>

                    <div class="out-of-stock hidden">
                        {{ trans('pages.products.out_of_stock') }}
                    </div>
                </div>

                {% if product.rating %}
                    <salla-rating-stars data-v42-group="price" value="{{ product.rating.stars }}"
                                        reviews="{{ product.rating.count }}"></salla-rating-stars>
                {% endif %}

                {% if product.is_taxable %}
                    <small class="color-grey" data-v42-group="price">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}
{% if vpp_enabled and vpp_show_availability and product.is_available %}
                    <div class="veloura-product-stock-radar {{ vpp_show_stock_radar ? 'is-pulse' : 'is-simple' }}" data-v42-group="status">
                        {# Veloura Stock Radar V37 start #}
                        {% if vpp_show_stock_radar %}
                            <span class="veloura-product-stock-radar__dot"></span>
                        {% endif %}
                        {# Veloura Stock Radar V37 end #}
                        <span>متوفر</span>
                    </div>
                {% endif %}

                {% if vpp_enabled and vpp_show_discount_countdown and product.discount_ends %}
                    <div class="veloura-product-discount-countdown" data-v42-group="status">
                        <i class="sicon-clock"></i>
                        <span>ينتهي الخصم قريباً</span>
                        <salla-count-down date="{{ product.discount_ends }}"></salla-count-down>
                    </div>
                {% endif %}

                <div class="product__description p-2 px-5 sm:p-1 leading-7 mb-3 {{ vpp_enabled and vpp_hide_short_description ? 'is-collapsed' : '' }}" data-v42-group="description">
                    {% set product_desc = product.description|default('')|replace({'&nbsp;': ' '}) %}
                    {% set vpp_desc_should_collapse = product.has_read_more or (vpp_enabled and vpp_hide_short_description) %}

                    <article class="article article--main relative leading-8 overflow-hidden transition-all duration-300 py-4"
                             id="more-content"
                             style="{{ vpp_desc_should_collapse ? 'max-height:8.5rem' : 'max-height:none' }}">
                        {{ product_desc|raw }}
                    </article>

                    {% if vpp_desc_should_collapse %}
                        <a id="btn-show-more"
                           class="veloura-product-read-more link--primary cursor-pointer"
                           aria-expanded="false"
                           data-more-text="{{ trans('pages.products.read_more') }}"
                           data-less-text="عرض أقل">
                            <span class="veloura-product-read-more__text">{{ trans('pages.products.read_more') }}</span>
                        </a>
                    {% endif %}
                </div>

                {% if product.tags|length and ((vpp_enabled and vpp_tags_enabled) or (not vpp_enabled and theme.settings.get('show_tags', true))) %}
                    <div class="mb-3 veloura-product-tags" data-v42-group="data">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}"
                               class="rtl:ml-2 ltr:mr-2 inline-flex  text-gray-500 hover:text-primary underline text-sm mb-1">{{ tag.name }}
                                ,</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Veloura: wishlist/share moved above product image #}

                {% set vpp_purchase_count_value = (product.sold_quantity|default(0)) + 0 %}
                {% set vpp_purchase_count_min_value = (vpp_purchase_count_min|default(0)) + 0 %}
                {% set vpp_custom_purchase_count_visible =
                    vpp_enabled
                    and vpp_purchase_count_enabled
                    and vpp_purchase_count_value >= vpp_purchase_count_min_value
                %}

                {% if vpp_custom_purchase_count_visible %}
                    <div class="veloura-product-original-purchase-count" data-v42-group="data">
                        <div class="veloura-product-purchase-count__sold">
                            <i class="sicon-fire"></i>
                            <span>{{ trans('pages.products.sold') }}</span>
                            <strong class="veloura-product-purchase-count__number">
                                {{ vpp_purchase_count_value }}
                            </strong>
                            <span>مرة</span>
                        </div>

                        {% if product.can_show_remained_quantity %}
                            <div class="veloura-product-purchase-count__remaining">
                                <i class="sicon-box-bankers"></i>
                                <span>{{ trans('pages.products.remained') }}</span>
                                <strong>{{ product.quantity }}</strong>
                            </div>
                        {% endif %}
                    </div>
                {% elseif (not vpp_enabled or not vpp_purchase_count_enabled)
                    and (product.sold_quantity or product.can_show_remained_quantity) %}
                    <div class="bg-white py-2.5 mb-5 rounded-md inline-flex text-sm veloura-product-original-purchase-count" data-v42-group="data">
                        {% if product.sold_quantity %}
                            <div class="px-4 !text-red-800">
                                <i class="sicon-fire rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div class="px-4 rtl:even:border-r ltr:even:border-l even:border-gray-200">
                                <i class="!text-red-800 sicon-box-bankers rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if product.sku %}
                    <div class="veloura-product-sku-card mb-4 bg-white rounded-md px-4 py-3" data-v42-group="data">
                        <div class="veloura-product-sku-card__label">
                            <i class="sicon-barcode"></i>
                            <span>{{ trans('pages.products.sku') }}</span>
                        </div>
                        <div class="text-unicode product-sku" dir="ltr">{{ product.sku }}</div>
                    </div>
                {% endif %}
                <div class="veloura-product-order-hook" data-v42-group="data">
                    {% hook 'product:single.description' %}
                </div>

                {% if product.has_metadata %}
                <salla-metadata data-v42-group="data"></salla-metadata>
                {% endif %}

                {% if (not vpp_enabled or vpp_show_availability) and product.show_availability %}
                    <section class="bg-white p-5 rounded-md mb-5 last:mb-0 veloura-product-availability-card" data-v42-group="extras">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <div class="flex rtl:space-x-reverse space-x-3">
                                    <a href="#!"
                                       onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                       class="group text-primary flex items-center justify-center">
                                        <span>{{ trans('pages.products.select_branch') }}</span>
                                        <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endif %}


				{# Digital Files Settings #}
				{% if product.digital_files_settings %}
					<digital-files-settings data-v42-group="extras" settings='{{ product.digital_files_settings|json_encode|e("html_attr") }}'></digital-files-settings>
				{% endif %}
				{# End Digital Files Settings #}

                <form class="form product-form" data-v42-group="options" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">


                    {% hook 'product:single.form.start' %}

                    <div class="veloura-product-options-wrap">
                        {% include 'pages.partials.product.options' %}
                    </div>

                    {% hook 'product:single.form.end' %}
{# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode|e("html_attr") }}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar veloura-product-sticky-bar veloura-product-purchase-card p-5">
                        {# Live price inside purchase card: below quantity, above buttons #}
                        <div class="veloura-product-cart-price-row">
                            <span class="veloura-product-cart-price-row__label">{{ trans('pages.products.price') }}</span>
                            <div class="price-wrapper" data-veloura-cart-price>
                                <h2 class="total-price">
                                    {{ product.is_on_sale
                                        ? product.sale_price|money
                                        : (product.starting_price ? product.starting_price|money : product.price|money) }}
                                </h2>
                                <span class="before-price {{ product.is_on_sale ? '' : 'hidden' }}">
                                    {{ product.regular_price|money }}
                                </span>
                            </div>
                        </div>

                        {# Quantity #}
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity">
                                <label class="form-label font-bold">
                                    {{ trans('pages.products.quantity') }}
                                </label>
                                <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                  class="border-gray-200 flex justify-end"></salla-quantity-input>
                            </div>
                        {% endif %}

                        {# Add to cart #}
                        <salla-add-product-button
                                {{product.can_quick_buy ? 'quick-buy' : ''}}
                                {{ ((vpp_enabled and vpp_mobile_sticky_cart) or (not vpp_enabled and theme.settings.get('sticky_add_to_cart'))) ? ' support-sticky-bar' : '' }}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                amount="{{ product.base_currency_price }}"
                                class="w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {# Notify availability props#}
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode|e('html_attr') }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>

                            {{ product.add_to_cart_label }}
                        </salla-add-product-button>
                    </section>
                    {% if product.is_giftable %}
                        <salla-gifting class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : ''  }}></salla-gifting>
                    {% endif %}
                </form>

                <div class="veloura-product-order-hook" data-v42-group="options">
                    {% hook 'product:single.description.end' %}
                </div>
                <salla-quick-order class="mt-5 md:-mb-2 block" data-v42-group="quick"></salla-quick-order>

                {# Payment methods are intentionally the final product-details element #}
                {% if not vpp_enabled or vpp_show_payment_methods %}
                    <div class="veloura-product-payment-methods veloura-product-payment-methods--last" data-v42-group="payments">
                        <salla-payments></salla-payments>
                        <salla-installment price="{{ product.price }}"></salla-installment>
                        {% hook 'product:single.payment_methods' %}
                    </div>
                {% endif %}
            </div>
        </div>
        <salla-offer></salla-offer>
    </div>

    {# Comments Area #}
    {% if store.settings.rating.show_on_product %}
        <salla-comments item-id="{{product.id}}" type="product" class="veloura-product-reviews"></salla-comments>
    {% endif %}
    
    {# Similar Products Area — V100 native Salla fetching + Veloura slider controls #}
    {% if not vpp_enabled or not vpp_hide_liked_products %}
        {% set veloura_related_source = 'related' %}
        {% set veloura_related_source_value = product.id %}

        {# المنتجات المختارة يدويًا #}
        {% if vpp_enabled
            and vpp_custom_related_enabled
            and vpp_custom_related_source == 'selected'
            and vpp_custom_related_products|length %}

            {% set veloura_product_ids = [] %}

            {% for related_product in vpp_custom_related_products %}
                {% set veloura_current_product_id = null %}

                {% if related_product.id is defined %}
                    {% set veloura_current_product_id = related_product.id %}
                {% elseif related_product.value is defined and related_product.value.id is defined %}
                    {% set veloura_current_product_id = related_product.value.id %}
                {% elseif related_product.value is defined %}
                    {% set veloura_current_product_id = related_product.value %}
                {% elseif related_product.key is defined %}
                    {% set veloura_current_product_id = related_product.key %}
                {% elseif related_product is not iterable %}
                    {% set veloura_current_product_id = related_product %}
                {% endif %}

                {% if veloura_current_product_id and veloura_current_product_id not in veloura_product_ids %}
                    {% set veloura_product_ids = veloura_product_ids|merge([veloura_current_product_id]) %}
                {% endif %}
            {% endfor %}

            {% if veloura_product_ids|length %}
                {% set veloura_related_source = 'selected' %}
                {% set veloura_related_source_value = veloura_product_ids %}
            {% endif %}

        {# المنتجات التابعة للتصنيفات المختارة #}
        {% elseif vpp_enabled
            and vpp_custom_related_enabled
            and vpp_custom_related_source == 'categories'
            and vpp_custom_related_category|length %}

            {% set veloura_category_ids = [] %}

            {% for related_category in vpp_custom_related_category %}
                {% set veloura_current_category_id = null %}

                {% if related_category.id is defined %}
                    {% set veloura_current_category_id = related_category.id %}
                {% elseif related_category.value is defined and related_category.value.id is defined %}
                    {% set veloura_current_category_id = related_category.value.id %}
                {% elseif related_category.value is defined %}
                    {% set veloura_current_category_id = related_category.value %}
                {% elseif related_category.key is defined %}
                    {% set veloura_current_category_id = related_category.key %}
                {% elseif related_category is not iterable %}
                    {% set veloura_current_category_id = related_category %}
                {% endif %}

                {% if veloura_current_category_id and veloura_current_category_id not in veloura_category_ids %}
                    {% set veloura_category_ids = veloura_category_ids|merge([veloura_current_category_id]) %}
                {% endif %}
            {% endfor %}

            {% if veloura_category_ids|length %}
                {% set veloura_related_source = 'categories' %}
                {% set veloura_related_source_value = veloura_category_ids %}
            {% endif %}
        {% endif %}

        {% set veloura_related_source_value_attr = veloura_related_source_value %}
        {% if veloura_related_source in ['selected', 'categories'] %}
            {% set veloura_related_source_value_attr = veloura_related_source_value|json_encode %}
        {% endif %}

        {% set veloura_related_slider_config = {
            'slidesPerView': vpp_related_mobile_columns|default(2),
            'slidesPerGroup': 1,
            'spaceBetween': 12,
            'watchOverflow': true,
            'allowTouchMove': true,
            'simulateTouch': true,
            'grabCursor': true,
            'breakpoints': {
                '768': {
                    'slidesPerView': vpp_related_desktop_columns|default(4),
                    'slidesPerGroup': 1,
                    'spaceBetween': 16
                }
            }
        } %}

        <div
            class="container veloura-product-related-products {{ vpp_related_center_title|default(false) ? 'is-title-centered' : '' }} {{ vpp_related_hide_arrows|default(false) ? 'is-arrows-hidden' : '' }}"
            data-veloura-related-section
            data-veloura-related-mobile="{{ vpp_related_mobile_columns|default(2) }}"
            data-veloura-related-desktop="{{ vpp_related_desktop_columns|default(4) }}"
            data-veloura-related-hide-arrows="{{ vpp_related_hide_arrows|default(false) ? 'true' : 'false' }}"
            data-veloura-related-center-title="{{ vpp_related_center_title|default(false) ? 'true' : 'false' }}"
        >
            {% if vpp_liked_title %}
                <div class="veloura-product-related-heading">
                    <h2 class="veloura-product-related-title">{{ vpp_liked_title }}</h2>
                </div>
            {% endif %}

            <salla-products-slider
                data-testid="store-product-related"
                data-veloura-related-slider
                source="{{ veloura_related_source }}"
                source-value="{{ veloura_related_source_value_attr|e('html_attr') }}"
                product-card-component="custom-salla-product-card"
                slider-config="{{ veloura_related_slider_config|json_encode|e('html_attr') }}"
            ></salla-products-slider>
        </div>
    {% endif %}
{% endblock %}

{% block scripts %}

    <script defer src="{{ 'product.js' | asset }}"></script>
    {# Veloura Product Sliders V97 — values only; runtime lives in existing product.js #}
    <script data-cfasync="false" id="veloura-product-slider-settings-v97">
      window.velouraProductSliderSettings = {
        related: {
          mobileColumns: {{ vpp_related_mobile_columns|default(2) }},
          desktopColumns: {{ vpp_related_desktop_columns|default(4) }},
          hideArrows: {{ vpp_related_hide_arrows|default(false) ? 'true' : 'false' }},
          centerTitle: {{ vpp_related_center_title|default(false) ? 'true' : 'false' }},
          customEnabled: {{ vpp_custom_related_enabled|default(false) ? 'true' : 'false' }},
          source: {{ veloura_related_source|default('related')|json_encode|raw }}
        },
        recent: {
          hide: {{ vpp_recent_hide|default(false) ? 'true' : 'false' }},
          customize: {{ vpp_recent_customize|default(false) ? 'true' : 'false' }},
          mobileColumns: {{ vpp_recent_mobile_columns|default(2) }},
          desktopColumns: {{ vpp_recent_desktop_columns|default(4) }},
          centerTitle: {{ vpp_recent_center_title|default(false) ? 'true' : 'false' }}
        }
      };
    </script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}