  data-v42-order-payments="{{ vpp_order_payments }}"
  data-veloura-v42-sticky="{{ vpp_mobile_sticky_cart ? 'true' : 'false' }}"
     data-veloura-product-build="v20-marketing-related" data-veloura-v37-stock-radar="{{ vpp_show_stock_radar ? 'pulse' : 'simple' }}" data-veloura-v37-images-zoom="{{ vpp_images_zoom ? 'true' : 'false' }}" data-veloura-quantity-style="{{ vpp_mobile_quantity_style }}" class="container veloura-product-page {{ vpp_enabled ? 'veloura-product-enabled' : '' }} {{ vpp_hide_breadcrumb ? 'veloura-product-hide-breadcrumb' : '' }} {{ vpp_hide_thumbnails ? 'veloura-product-hide-thumbs' : '' }} veloura-product-images-{{ vpp_images_height_mode }} {{ vpp_images_zoom ? 'veloura-product-zoom-enabled' : '' }} {{ vpp_enabled and vpp_hide_short_description ? 'veloura-product-desc-collapsed' : '' }} {{ vpp_mobile_sticky_cart ? 'veloura-product-mobile-sticky-enabled' : 'veloura-product-mobile-sticky-disabled' }} {{ vpp_mobile_sticky_price ? 'veloura-product-mobile-sticky-price' : '' }} veloura-product-qty-{{ vpp_mobile_quantity_style }} {{ vpp_mobile_buttons_compact ? 'veloura-product-buttons-compact' : '' }} {{ vpp_hide_discount_value ? 'veloura-product-hide-discount' : '' }} {{ vpp_hide_tags_visual_only ? 'veloura-product-tags-visual-hidden' : '' }}" style="--veloura-product-bg-inline: {{ vpp_basic_bg }}; --veloura-product-secondary-bg-inline: {{ vpp_second_bg }}; --veloura-product-dark-bg-inline: {{ vpp_dark_basic_bg }}; --veloura-product-dark-secondary-bg-inline: {{ vpp_dark_second_bg }}; --veloura-product-radius: {{ vpp_general_radius }};" >

        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        {% if not (vpp_enabled and vpp_hide_breadcrumb) %}
            <nav class="breadcrumbs w-full py-5 veloura-product-breadcrumb">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        {% endif %}
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            <div class="sidebar md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 pb-8 md:pb-16 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        type="thumbs"
                        loop="false"
                        {{ vpp_images_height_mode == 'fixed_all' ? '' : 'auto-height' }}
                        listen-to-thumbnails-option
                thumbs-config='{
                  "slidesPerView": 4,
                  "slidesPerGroup": 1,
                  "spaceBetween": 10,
                  "freeMode": true,
                  "watchSlidesProgress": true,
                  "allowTouchMove": true,
                  "roundLengths": true,
                  "breakpoints": {
                    "768": {"slidesPerView": 5, "slidesPerGroup": 1, "spaceBetween": 12}
                  }
                }'
                show-thumbs-controls="false">
                    <div class="veloura-product-media-actions">
                        <div class="veloura-product-media-actions__left">
                            <button type="button"
                                    class="veloura-product-media-action-btn veloura-product-media-wishlist"
                                    data-id="{{ product.id }}"
                                    onclick="salla.wishlist.toggle('{{ product.id }}')"
                                    aria-label="add to wishlist">
                                <i class="sicon-heart"></i>
                            </button>

                            <salla-social-share
                                    class="veloura-product-media-action-btn veloura-product-media-share"
                                    aria-label="social share">
                            </salla-social-share>
                        </div>

                        {% if product.promotion_title %}
                            <div class="promotion-title veloura-product-media-promo">{{ product.promotion_title }}</div>
                        {% endif %}
                    </div>

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images and not (vpp_enabled and vpp_hide_thumbnails) %}
                        <div slot="thumbs" class="veloura-product-native-thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth veloura-product-thumb-item {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    {% if loop.index < 5 %}
                                        <img src="{{ image.url }}"
                                             loading="eager"
                                             class="object-contain w-full h-full bg-gray-100 overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% else %}
                                        <img src="{{ image.url }}"
                                             loading="lazy"
                                             class="object-contain w-full h-full bg-gray-100 overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            <div class="main-content md:sticky md:overflow-hidden top-24 w-full md:w-2/4 md:pb-16">

                {% hook 'product:single.description.start' %}

                {% if product.brand and product.brand.name and (not vpp_enabled or vpp_show_brand) %}
                    <div class="product-brand veloura-product-brand mb-5">
                        {% if not vpp_brand_title_image_only %}
                            <span class="veloura-product-brand__label">{{ vpp_brand_label }}</span>
                        {% endif %}
                        <a class="brand-logo veloura-product-brand__logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            {% if product.brand.logo %}
                                <img width="100%" height="100%" class="max-h-full object-contain"
                                     src="{{ product.brand.logo }}"
                                     title="{{ product.brand.name }}"
                                     alt="{{ product.brand.name }}">
                            {% endif %}
                            <span class="veloura-product-brand__name">{{ product.brand.name }}</span>
                        </a>
                    </div>
                {% endif %}

                <h1 class="text-xl md:text-2xl leading-10 font-bold mb-6 text-gray-800">{{ product.name }}</h1>

                {% if vpp_enabled and vpp_show_category and product.category and product.category.name %}
                    <div class="veloura-product-category-under-title">
                        <span>{{ vpp_category_label }}</span>
                        <a href="{{ product.category.url }}">{{ product.category.name }}</a>
                    </div>
                {% endif %}

                {% if product.subtitle and not (vpp_enabled and vpp_hide_short_description) %}
                    <h2 class="product-entry__sub-title text-sm text-gray-500 leading-6 mb-2.5">
                        {{ product.subtitle }}
                    </h2>
                {% endif %}


                {# One canonical live price directly under the product title/subtitle #}
                <div class="veloura-product-header-price">
                    <div class="price-wrapper" data-veloura-single-price>
                        {% if product.starting_price and not product.is_on_sale %}
                            <span class="starting-price-title">{{ trans('pages.products.starting_price') }}</span>
                        {% endif %}

                        <h2 class="total-price">
                            {{ product.is_on_sale
                                ? product.sale_price|money
                                : (product.starting_price ? product.starting_price|money : product.price|money) }}
                        </h2>

                        <span class="before-price {{ product.is_on_sale ? '' : 'hidden' }}">
                            {{ product.regular_price|money }}
                        </span>
                    </div>

                    <div class="out-of-stock hidden">
                        {{ trans('pages.products.out_of_stock') }}
                    </div>
                </div>

                {% if product.rating %}
                    <salla-rating-stars value="{{ product.rating.stars }}"
                                        reviews="{{ product.rating.count }}"></salla-rating-stars>
                {% endif %}

                {% if product.is_taxable %}
                    <small class="color-grey">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}
{% if vpp_enabled and vpp_show_availability and product.is_available %}
                    <div class="veloura-product-stock-radar {{ vpp_show_stock_radar ? 'is-pulse' : 'is-simple' }}">
                        {# Veloura Stock Radar V37 start #}
                        {% if vpp_show_stock_radar %}
                            <span class="veloura-product-stock-radar__dot"></span>
                        {% endif %}
                        {# Veloura Stock Radar V37 end #}
                        <span>متوفر</span>
                    </div>
                {% endif %}

                {% if vpp_enabled and vpp_show_discount_countdown and product.discount_ends %}
                    <div class="veloura-product-discount-countdown">
                        <i class="sicon-clock"></i>
                        <span>ينتهي الخصم قريباً</span>
                        <salla-count-down date="{{ product.discount_ends }}"></salla-count-down>
                    </div>
                {% endif %}

                {% if vpp_coupon_enabled and vpp_coupon_code %}
                    <div class="veloura-product-coupon" data-veloura-copy-coupon="{{ vpp_coupon_code }}">
                        <div>
                            <strong>{{ vpp_coupon_title }}</strong>
                            <span>{{ vpp_coupon_subtitle }}</span>
                        </div>
                        <button type="button"
                                class="veloura-product-coupon__code"
                                data-code="{{ vpp_coupon_code|e('html_attr') }}"
                                aria-label="نسخ كود الخصم">
                            {{ vpp_coupon_code }}
                        </button>
                    </div>
                {% endif %}

                <div class="product__description p-2 px-5 sm:p-1 leading-7 mb-3 {{ vpp_enabled and vpp_hide_short_description ? 'is-collapsed' : '' }}">
                    {% set product_desc = product.description|default('')|replace({'&nbsp;': ' '}) %}
                    {% set vpp_desc_should_collapse = product.has_read_more or (vpp_enabled and vpp_hide_short_description) %}

                    <article class="article article--main relative leading-8 overflow-hidden transition-all duration-300 py-4"
                             id="more-content"
                             style="{{ vpp_desc_should_collapse ? 'max-height:8.5rem' : 'max-height:none' }}">
                        {{ product_desc|raw }}
                    </article>

                    {% if vpp_desc_should_collapse %}
                        <a id="btn-show-more"
                           class="veloura-product-read-more link--primary cursor-pointer"
                           aria-expanded="false"
                           data-more-text="{{ trans('pages.products.read_more') }}"
                           data-less-text="عرض أقل">
                            <span class="veloura-product-read-more__text">{{ trans('pages.products.read_more') }}</span>
                        </a>
                    {% endif %}
                </div>

                {% if product.tags|length and ((vpp_enabled and vpp_tags_enabled) or (not vpp_enabled and theme.settings.get('show_tags', true))) %}
                    <div class="mb-3">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}"
                               class="rtl:ml-2 ltr:mr-2 inline-flex  text-gray-500 hover:text-primary underline text-sm mb-1">{{ tag.name }}
                                ,</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Veloura: wishlist/share moved above product image #}

                {% set vpp_purchase_count_value = (product.sold_quantity|default(0)) + 0 %}
                {% set vpp_purchase_count_min_value = (vpp_purchase_count_min|default(0)) + 0 %}
                {% set vpp_custom_purchase_count_visible =
                    vpp_enabled
                    and vpp_purchase_count_enabled
                    and vpp_purchase_count_value >= vpp_purchase_count_min_value
                %}

                {% if vpp_custom_purchase_count_visible %}
                    <div class="veloura-product-original-purchase-count"
>
                        <div class="veloura-product-purchase-count__sold">
                            <i class="sicon-fire"></i>
                            <span>{{ trans('pages.products.sold') }}</span>
                            <strong class="veloura-product-purchase-count__number">
                                {{ vpp_purchase_count_value }}
                            </strong>
                            <span>مرة</span>
                        </div>

                        {% if product.can_show_remained_quantity %}
                            <div class="veloura-product-purchase-count__remaining">
                                <i class="sicon-box-bankers"></i>
                                <span>{{ trans('pages.products.remained') }}</span>
                                <strong>{{ product.quantity }}</strong>
                            </div>
                        {% endif %}
                    </div>
                {% elseif (not vpp_enabled or not vpp_purchase_count_enabled)
                    and (product.sold_quantity or product.can_show_remained_quantity) %}
                    <div class="bg-white py-2.5 mb-5 rounded-md inline-flex text-sm veloura-product-original-purchase-count">
                        {% if product.sold_quantity %}
                            <div class="px-4 !text-red-800">
                                <i class="sicon-fire rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div class="px-4 rtl:even:border-r ltr:even:border-l even:border-gray-200">
                                <i class="!text-red-800 sicon-box-bankers rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if product.sku %}
                    <div class="veloura-product-sku-card mb-4 bg-white rounded-md px-4 py-3">
                        <div class="veloura-product-sku-card__label">
                            <i class="sicon-barcode"></i>
                            <span>{{ trans('pages.products.sku') }}</span>
                        </div>
                        <div class="text-unicode product-sku" dir="ltr">{{ product.sku }}</div>
                    </div>
                {% endif %}
                {% hook 'product:single.description' %}

                {% if product.has_metadata %}
                <salla-metadata></salla-metadata>
                {% endif %}

                {% if (not vpp_enabled or vpp_show_availability) and product.show_availability %}
                    <section class="bg-white p-5 rounded-md mb-5 last:mb-0">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <div class="flex rtl:space-x-reverse space-x-3">
                                    <a href="#!"
                                       onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                       class="group text-primary flex items-center justify-center">
                                        <span>{{ trans('pages.products.select_branch') }}</span>
                                        <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endif %}


				{# Digital Files Settings #}
				{% if product.digital_files_settings %}
					<digital-files-settings settings='{{ product.digital_files_settings|json_encode|e("html_attr") }}'></digital-files-settings>
				{% endif %}
				{# End Digital Files Settings #}

                <form class="form product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">


                    {% hook 'product:single.form.start' %}

                    <div class="veloura-product-options-wrap">
                        {% include 'pages.partials.product.options' %}
                    </div>

                    {% hook 'product:single.form.end' %}
{# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode|e("html_attr") }}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar veloura-product-sticky-bar veloura-product-purchase-card p-5">
                        {# Live price inside purchase card: below quantity, above buttons #}
                        <div class="veloura-product-cart-price-row">
                            <span class="veloura-product-cart-price-row__label">{{ trans('pages.products.price') }}</span>
                            <div class="price-wrapper" data-veloura-cart-price>
                                <h2 class="total-price">
                                    {{ product.is_on_sale
                                        ? product.sale_price|money
                                        : (product.starting_price ? product.starting_price|money : product.price|money) }}
                                </h2>
                                <span class="before-price {{ product.is_on_sale ? '' : 'hidden' }}">
                                    {{ product.regular_price|money }}
                                </span>
                            </div>
                        </div>

                        {# Quantity #}
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity">
                                <label class="form-label font-bold">
                                    {{ trans('pages.products.quantity') }}
                                </label>
                                <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                  class="border-gray-200 flex justify-end"></salla-quantity-input>
                            </div>
                        {% endif %}

                        {# Add to cart #}
                        <salla-add-product-button
                                {{product.can_quick_buy ? 'quick-buy' : ''}}
                                {{ ((vpp_enabled and vpp_mobile_sticky_cart) or (not vpp_enabled and theme.settings.get('sticky_add_to_cart'))) ? ' support-sticky-bar' : '' }}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                amount="{{ product.base_currency_price }}"
                                class="w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {# Notify availability props#}
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode|e('html_attr') }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>

                            {{ product.add_to_cart_label }}
                        </salla-add-product-button>
                    </section>
                    {% if product.is_giftable %}
                        <salla-gifting class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : ''  }}></salla-gifting>
                    {% endif %}
                </form>

                {% hook 'product:single.description.end' %}
                <salla-quick-order class="mt-5 md:-mb-2 block"></salla-quick-order>

                {# Payment methods are intentionally the final product-details element #}
                {% if not vpp_enabled or vpp_show_payment_methods %}
                    <div class="veloura-product-payment-methods veloura-product-payment-methods--last">
                        <salla-payments></salla-payments>
                        <salla-installment price="{{ product.price }}"></salla-installment>
                        {% hook 'product:single.payment_methods' %}
                    </div>
                {% endif %}
            </div>
        </div>
        <salla-offer></salla-offer>
    </div>

    {# Comments Area #}
    {% if store.settings.rating.show_on_product %}
        <salla-comments item-id="{{product.id}}" type="product" class="veloura-product-reviews"></salla-comments>
    {% endif %}
    
    {# Similar Products Area #}
    {% if not vpp_enabled or not vpp_hide_liked_products %}
        {% set veloura_related_source = 'related' %}
        {% set veloura_related_source_value = product.id %}

        {# المنتجات المختارة يدويًا #}
        {% if vpp_enabled
            and vpp_custom_related_enabled
            and vpp_custom_related_source == 'selected'
            and vpp_custom_related_products|length %}

            {% set veloura_product_ids = [] %}

            {% for related_product in vpp_custom_related_products %}
                {% set veloura_current_product_id = null %}

                {% if related_product.id is defined %}
                    {% set veloura_current_product_id = related_product.id %}
                {% elseif related_product.value is defined and related_product.value.id is defined %}
                    {% set veloura_current_product_id = related_product.value.id %}
                {% elseif related_product.value is defined %}
                    {% set veloura_current_product_id = related_product.value %}
                {% elseif related_product.key is defined %}
                    {% set veloura_current_product_id = related_product.key %}
                {% elseif related_product is not iterable %}
                    {% set veloura_current_product_id = related_product %}
                {% endif %}

                {% if veloura_current_product_id and veloura_current_product_id not in veloura_product_ids %}
                    {% set veloura_product_ids = veloura_product_ids|merge([veloura_current_product_id]) %}
                {% endif %}
            {% endfor %}

            {% if veloura_product_ids|length %}
                {% set veloura_related_source = 'selected' %}
                {% set veloura_related_source_value = veloura_product_ids %}
            {% endif %}

        {# المنتجات التابعة للتصنيفات المختارة #}
        {% elseif vpp_enabled
            and vpp_custom_related_enabled
            and vpp_custom_related_source == 'categories'
            and vpp_custom_related_category|length %}

            {% set veloura_category_ids = [] %}

            {% for related_category in vpp_custom_related_category %}
                {% set veloura_current_category_id = null %}

                {% if related_category.id is defined %}
                    {% set veloura_current_category_id = related_category.id %}
                {% elseif related_category.value is defined and related_category.value.id is defined %}
                    {% set veloura_current_category_id = related_category.value.id %}
                {% elseif related_category.value is defined %}
                    {% set veloura_current_category_id = related_category.value %}
                {% elseif related_category.key is defined %}
                    {% set veloura_current_category_id = related_category.key %}
                {% elseif related_category is not iterable %}
                    {% set veloura_current_category_id = related_category %}
                {% endif %}

                {% if veloura_current_category_id and veloura_current_category_id not in veloura_category_ids %}
                    {% set veloura_category_ids = veloura_category_ids|merge([veloura_current_category_id]) %}
                {% endif %}
            {% endfor %}

            {% if veloura_category_ids|length %}
                {% set veloura_related_source = 'categories' %}
                {% set veloura_related_source_value = veloura_category_ids %}
            {% endif %}
        {% endif %}

        {# related يستقبل product_id، أما selected/categories فتستقبل JSON array من IDs #}
        {% set veloura_related_source_value_attr = veloura_related_source_value %}
        {% if veloura_related_source in ['selected', 'categories'] %}
            {% set veloura_related_source_value_attr = veloura_related_source_value|json_encode %}
        {% endif %}

        

        <div class="container veloura-product-related-products {{ vpp_related_center_title|default(false) ? 'is-title-centered' : '' }} {{ vpp_related_hide_arrows|default(false) ? 'is-arrows-hidden' : '' }}">
            {% if vpp_liked_title %}
                <div class="veloura-product-related-heading">
                    <h2 class="veloura-product-related-title">{{ vpp_liked_title }}</h2>
                </div>
            {% endif %}
            <salla-products-slider
                source="{{ veloura_related_source }}"
                source-value="{{ veloura_related_source_value_attr|e('html_attr') }}"
                product-card-component="custom-salla-product-card"
                display-all-url
                data-veloura-related-slider
                data-veloura-related-mobile="{{ vpp_related_mobile_columns|default(2) }}"
                data-veloura-related-desktop="{{ vpp_related_desktop_columns|default(4) }}"
                data-veloura-related-hide-arrows="{{ vpp_related_hide_arrows|default(false) ? 'true' : 'false' }}"
                data-veloura-related-center-title="{{ vpp_related_center_title|default(false) ? 'true' : 'false' }}"
                data-veloura-related-snap="one"
                slider-config='{
                  "slidesPerView": {{ vpp_related_mobile_columns|default(2) }},
                  "slidesPerGroup": 1,
                  "spaceBetween": 12,
                  "centeredSlides": false,
                  "centeredSlidesBounds": false,
                  "centerInsufficientSlides": false,
                  "freeMode": false,
                  "allowTouchMove": true,
                  "simulateTouch": true,
                  "grabCursor": true,
                  "threshold": 4,
                  "touchStartPreventDefault": false,
                  "touchMoveStopPropagation": false,
                  "touchReleaseOnEdges": true,
                  "resistance": true,
                  "resistanceRatio": 0.85,
                  "preventInteractionOnTransition": false,
                  "observer": false,
                  "observeParents": false,
                  "observeSlideChildren": false,
                  "roundLengths": true,
                  "slidesOffsetBefore": 0,
                  "slidesOffsetAfter": 0,
                  "breakpoints": {
                    "768": {
                      "slidesPerView": {{ vpp_related_desktop_columns|default(4) }},
                      "slidesPerGroup": 1,
                      "spaceBetween": 16,
                      "centeredSlides": false,
                      "freeMode": false,
                      "allowTouchMove": true,
                      "simulateTouch": true,
                      "grabCursor": true,
                      "threshold": 4,
                      "touchReleaseOnEdges": true,
                      "resistance": true,
                      "resistanceRatio": 0.85,
                      "roundLengths": true,
                      "slidesOffsetBefore": 0,
                      "slidesOffsetAfter": 0
                    }
                  }
                }'>
            </salla-products-slider>
        </div>
    {% endif %}
{% endblock %}

{% block scripts %}

    <script defer src="{{ 'product.js' | asset }}"></script>
    {# Veloura product slider columns: only column counts + recently-viewed title alignment. #}
    <script data-veloura-product-sliders-stable>
      (function () {
        'use strict';

        var related = document.querySelector('[data-veloura-related-slider]');
        var tracked = [];
        var relatedConfig = {
          mobileColumns: {{ vpp_related_mobile_columns|default(2) }},
          desktopColumns: {{ vpp_related_desktop_columns|default(4) }},
          centerTitle: {{ vpp_related_center_title|default(false) ? 'true' : 'false' }},
          hideArrows: {{ vpp_related_hide_arrows|default(false) ? 'true' : 'false' }},
          customize: true
        };
        var recentConfig = {
          hide: {{ vpp_recent_hide ? 'true' : 'false' }},
          customize: {{ vpp_recent_customize ? 'true' : 'false' }},
          mobileColumns: {{ vpp_recent_mobile_columns|default(2) }},
          desktopColumns: {{ vpp_recent_desktop_columns|default(4) }},
          centerTitle: {{ vpp_recent_center_title|default(false) ? 'true' : 'false' }},
          hideArrows: false
        };

        function clean(value) {
          return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();
        }

        function composedParent(node) {
          if (!node) return null;
          if (node.parentNode) return node.parentNode;
          var root = node.getRootNode && node.getRootNode();
          return root && root.host ? root.host : null;
        }

        function recentText(node) {
          if (!node) return '';
          return clean([
            node.id,
            typeof node.className === 'string' ? node.className : '',
            node.getAttribute && node.getAttribute('title'),
            node.getAttribute && node.getAttribute('block-title'),
            node.getAttribute && node.getAttribute('sub-title'),
            node.getAttribute && node.getAttribute('data-title'),
            node.textContent
          ].filter(Boolean).join(' '));
        }

        function isRecent(node) {
          var text = recentText(node);
          return text.indexOf('شاهدتها مؤخ') !== -1 ||
            text.indexOf('recently viewed') !== -1 ||
            text.indexOf('recently-viewed') !== -1;
        }

        function findSection(component) {
          if (component && component.__velouraRecentSection) return component.__velouraRecentSection;
          var current = component;
          for (var depth = 0; current && depth < 12; depth += 1) {
            if (current.matches && current.matches('.veloura-product-related-products')) return current;
            if (isRecent(current)) return current;
            current = composedParent(current);
          }
          return component && (component.parentElement || component);
        }

        function findProductSlider(node) {
          var current = node;
          for (var depth = 0; current && depth < 12; depth += 1) {
            if (current.matches && current.matches('salla-products-slider,salla-products-list')) return current;
            current = composedParent(current);
          }
          return null;
        }

        function isDesktop() {
          return !!(window.matchMedia && window.matchMedia('(min-width: 768px)').matches);
        }

        function activeColumns(config) {
          var desktop = isDesktop();
          var max = desktop ? 6 : 3;
          var fallback = desktop ? 4 : 2;
          var value = desktop ? config.desktopColumns : config.mobileColumns;
          return Math.max(1, Math.min(max, Number(value) || fallback));
        }

        function activeGap() {
          return isDesktop() ? 16 : 12;
        }

        function sliderValue(config) {
          return {
            slidesPerView: 'auto',
            slidesPerGroup: 1,
            spaceBetween: activeGap(),
            centeredSlides: false,
            centeredSlidesBounds: false,
            centerInsufficientSlides: false,
            freeMode: false,
            allowTouchMove: true,
            simulateTouch: true,
            grabCursor: true,
            threshold: 5,
            touchRatio: 1,
            touchStartPreventDefault: false,
            touchMoveStopPropagation: false,
            touchReleaseOnEdges: true,
            resistance: true,
            resistanceRatio: 0.85,
            shortSwipes: true,
            longSwipes: true,
            longSwipesRatio: 0.35,
            preventInteractionOnTransition: false,
            watchOverflow: true,
            observer: false,
            observeParents: false,
            observeSlideChildren: false,
            roundLengths: true,
            breakpoints: {}
          };
        }

        function findSwiper(inner) {
          if (!inner) return null;
          var root = inner.shadowRoot;
          var viewport = root && root.querySelector && root.querySelector('.swiper,.swiper-container');
          return inner.swiper || inner.slider || inner.swiperInstance ||
            (viewport && viewport.swiper) || null;
        }

        function normalizeSlides(result, inner) {
          var list = [];
          if (Array.isArray(result)) list = result;
          else if (result && typeof result.length === 'number') list = Array.prototype.slice.call(result);
          else if (result && Array.isArray(result.slides)) list = result.slides;

          if (!list.length && inner && inner.querySelectorAll) {
            list = Array.prototype.slice.call(inner.querySelectorAll('[slot="items"],.swiper-slide'));
          }
          if (!list.length && inner && inner.shadowRoot && inner.shadowRoot.querySelectorAll) {
            list = Array.prototype.slice.call(inner.shadowRoot.querySelectorAll('.swiper-slide'));
          }

          var unique = [];
          list.forEach(function (item) {
            if (!item || item.nodeType !== 1) return;
            var slide = item.matches && item.matches('.swiper-slide')
              ? item
              : (item.closest && item.closest('.swiper-slide')) || item;
            if (unique.indexOf(slide) === -1) unique.push(slide);
          });
          return unique;
        }

        function setSlideWidths(slides, config) {
          var columns = activeColumns(config);
          var gap = activeGap();
          var width = 'calc((100% - ' + ((columns - 1) * gap) + 'px) / ' + columns + ')';
          slides.forEach(function (slide) {
            if (!slide || !slide.style) return;
            slide.style.setProperty('width', width, 'important');
            slide.style.setProperty('max-width', width, 'important');
            slide.style.setProperty('flex', '0 0 ' + width, 'important');
          });
        }

        function installShadowStyle(inner, config) {
          var root = inner && inner.shadowRoot;
          if (!root || !root.querySelector) return;
          var columns = activeColumns(config);
          var gap = activeGap();
          var width = 'calc((100% - ' + ((columns - 1) * gap) + 'px) / ' + columns + ')';
          var style = root.querySelector('#veloura-product-columns-only');
          if (!style) {
            style = document.createElement('style');
            style.id = 'veloura-product-columns-only';
            root.appendChild(style);
          }
          style.textContent = '.swiper-slide{width:' + width + '!important;max-width:' + width + '!important;flex:0 0 ' + width + '!important}';
        }

        function callMethod(inner, name) {
          if (!inner || typeof inner[name] !== 'function') return Promise.resolve();
          try {
            return Promise.resolve(inner[name]()).catch(function () {});
          } catch (error) {
            return Promise.resolve();
          }
        }

        function applyInnerColumns(inner, config, attempt) {
          if (!inner || !config.customize) return;
          attempt = Number(attempt) || 0;

          var columns = activeColumns(config);
          var value = sliderValue(config);
          inner.setAttribute('slides-per-view', 'auto');
          inner.setAttribute('slider-config', JSON.stringify(value));
          try { inner.slidesPerView = 'auto'; } catch (error) {}
          try { inner.sliderConfig = value; } catch (error) {}
          installShadowStyle(inner, config);

          var slidePromise = typeof inner.getSlides === 'function'
            ? Promise.resolve(inner.getSlides()).catch(function () { return []; })
            : Promise.resolve([]);

          slidePromise.then(function (result) {
            var slides = normalizeSlides(result, inner);
            setSlideWidths(slides, config);

            var swiper = findSwiper(inner);
            if (swiper && swiper.params) {
              swiper.params.slidesPerView = 'auto';
              swiper.params.slidesPerGroup = 1;
              swiper.params.spaceBetween = activeGap();
              swiper.params.breakpoints = {};
              if (swiper.originalParams) {
                swiper.originalParams.slidesPerView = 'auto';
                swiper.originalParams.slidesPerGroup = 1;
                swiper.originalParams.spaceBetween = activeGap();
                swiper.originalParams.breakpoints = {};
              }
            }

            return callMethod(inner, 'updateSlides')
              .then(function () { return callMethod(inner, 'update'); })
              .then(function () {
                requestAnimationFrame(function () {
                  setSlideWidths(normalizeSlides([], inner), config);
                  installShadowStyle(inner, config);
                });
              });
          }).then(function () {
            inner.dataset.velouraColumns = String(columns);
          });

          if (!inner.__velouraAfterInitBound) {
            inner.__velouraAfterInitBound = true;
            inner.addEventListener('afterInit', function () {
              applyInnerColumns(inner, config, 99);
            }, { once: true });
          }

          if (attempt < 4) {
            window.setTimeout(function () {
              if (inner.dataset.velouraColumns !== String(activeColumns(config))) {
                applyInnerColumns(inner, config, attempt + 1);
              }
            }, 180 + (attempt * 180));
          }
        }

        function findInnerSliders(component) {
          var found = [];
          function add(root) {
            if (!root || !root.querySelectorAll) return;
            root.querySelectorAll('salla-slider').forEach(function (inner) {
              if (found.indexOf(inner) === -1) found.push(inner);
            });
          }
          add(component);
          add(component && component.shadowRoot);
          return found;
        }

        function findRecentHeading(section) {
          if (!section || !section.querySelectorAll) return null;
          var headings = section.querySelectorAll('h1,h2,h3,h4,.s-block__title,.s-slider-block__title,[class*="title"]');
          for (var index = 0; index < headings.length; index += 1) {
            if (isRecent(headings[index])) return headings[index];
          }
          return null;
        }

        function syncRecentTitle(section, enabled) {
          var heading = findRecentHeading(section);
          if (!heading || !heading.style) return;
          heading.style.setProperty('margin-bottom', '18px', 'important');
          if (enabled) {
            heading.style.setProperty('width', '100%', 'important');
            heading.style.setProperty('text-align', 'center', 'important');
            heading.style.setProperty('justify-content', 'center', 'important');
            heading.style.setProperty('margin-inline', 'auto', 'important');
          } else {
            heading.style.removeProperty('width');
            heading.style.removeProperty('text-align');
            heading.style.removeProperty('justify-content');
            heading.style.removeProperty('margin-inline');
          }
        }

        function track(component, config, type) {
          var item = tracked.find(function (entry) { return entry.component === component; });
          if (!item) {
            item = { component: component, config: config, type: type };
            tracked.push(item);
          } else {
            item.config = config;
            item.type = type;
          }
          return item;
        }

        function configureComponent(component, config, type) {
          if (!component) return;
          var section = findSection(component);

          if (type === 'recent' && config.hide) {
            if (section && section.style) section.style.setProperty('display', 'none', 'important');
            return;
          }

          if (type === 'recent') {
            syncRecentTitle(section, !!(config.customize && config.centerTitle));
          }

          track(component, config, type);

          function apply() {
            findInnerSliders(component).forEach(function (inner) {
              applyInnerColumns(inner, config, 0);
            });
          }

          apply();
          if (typeof component.componentOnReady === 'function') {
            Promise.resolve(component.componentOnReady()).then(apply).catch(function () {});
          }
          window.setTimeout(apply, 250);
          window.setTimeout(apply, 700);
        }

        function route(component) {
          if (!component) return;
          if (component === related || (component.matches && component.matches('[data-veloura-related-slider]'))) {
            configureComponent(component, relatedConfig, 'related');
            return;
          }
          var section = findSection(component);
          if (isRecent(component) || isRecent(section)) {
            configureComponent(component, recentConfig, 'recent');
          }
        }

        function routeRecentHeadings() {
          document.querySelectorAll('h1,h2,h3,h4,.s-block__title,.s-slider-block__title').forEach(function (heading) {
            if (!isRecent(heading)) return;
            var section = heading.closest('section,.container,[class*="recent"],[class*="slider"]') || heading.parentElement;
            var component = section && section.querySelector('salla-products-slider,salla-products-list');
            if (!component) return;
            component.__velouraRecentSection = section;
            configureComponent(component, recentConfig, 'recent');
          });
        }

        function registerHooks() {
          if (window.__velouraColumnsOnlyHooks) return;
          var api = window.Salla || window.salla;
          if (!api || !api.hooks || typeof api.hooks.registerHook !== 'function') return;
          window.__velouraColumnsOnlyHooks = true;

          api.hooks.registerHook('salla-products-slider', 'componentDidLoad', route);
          api.hooks.registerHook('salla-products-list', 'componentDidLoad', route);
          api.hooks.registerHook('salla-slider', 'componentDidLoad', function (inner) {
            var owner = findProductSlider(inner);
            if (owner) route(owner);
            var item = tracked.find(function (entry) {
              var root = entry.component.shadowRoot || entry.component;
              return root && root.contains && root.contains(inner);
            });
            if (item) applyInnerColumns(inner, item.config, 0);
          });
        }

        function refresh() {
          tracked.forEach(function (item) {
            if (item.type === 'recent') {
              syncRecentTitle(findSection(item.component), !!(item.config.customize && item.config.centerTitle));
            }
            findInnerSliders(item.component).forEach(function (inner) {
              applyInnerColumns(inner, item.config, 0);
            });
          });
        }

        function start() {
          if (related) route(related);
          document.querySelectorAll('salla-products-slider,salla-products-list').forEach(route);
          routeRecentHeadings();

          var api = window.Salla || window.salla;
          if (api && typeof api.onReady === 'function') api.onReady(registerHooks);
          else registerHooks();

          var resizeFrame = 0;
          window.addEventListener('resize', function () {
            cancelAnimationFrame(resizeFrame);
            resizeFrame = requestAnimationFrame(refresh);
          }, { passive: true });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      }());
    </script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}