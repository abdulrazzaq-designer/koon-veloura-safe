    var wishlist = pickRoot(wishlistRaw);
    var quick = pickRoot(quickRaw);

    if (wishlist && !wishlist.closest('salla-add-product-button')) {
      wishlist.classList.add('veloura-pc-native-wish');
      markCleanParents(wishlist);
    }

    if (quick && !quick.closest('salla-add-product-button')) {
      quick.classList.add('veloura-pc-native-quick');
      markCleanParents(quick);
    }

    syncQuickViewPosition(card);

    var promos = card.querySelectorAll(
      '.s-product-card-image [class*="promotion"], .s-product-card-image [class*="promo"], .s-product-card-image [class*="badge"], .s-product-card-image [class*="ribbon"]'
    );

    promos.forEach(function (promo) {
      promo.classList.add('veloura-pc-native-promo');
    });

    imageBox.classList.add('veloura-pc-image-actions-host');
  }

  function scanCards() {
    document.querySelectorAll('product-card, .s-product-card-entry').forEach(function (node) {
      var card = node.classList && node.classList.contains('s-product-card-entry')
        ? node
        : node.querySelector && node.querySelector('.s-product-card-entry');

      markCard(card || node);
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    scanCards();
    setTimeout(scanCards, 300);
    setTimeout(scanCards, 900);
    setTimeout(scanCards, 1800);

    /*
     * Salla Theme Editor can re-render a product card at any time, not only
     * during the first 10 seconds. Keep one lightweight observer alive, but
     * react ONLY when added nodes are product cards or contain product cards.
     */
    if (!window.__velouraProductCardLiveObserver) {
      var pendingCards = new Set();
      var scheduled = false;

      function scheduleCards() {
        if (scheduled) return;
        scheduled = true;

        window.requestAnimationFrame(function () {
          scheduled = false;

          pendingCards.forEach(function (card) {
            if (card && card.isConnected) {
              markCard(card);
            }
          });

          pendingCards.clear();
        });
      }

      window.__velouraProductCardLiveObserver =
        new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
              if (!(node instanceof Element)) return;

              if (node.matches('.s-product-card-entry')) {
                pendingCards.add(node);
              }

              if (node.matches('product-card')) {
                var directCard =
                  node.querySelector('.s-product-card-entry');

                if (directCard) pendingCards.add(directCard);
              }

              node
                .querySelectorAll?.(
                  'product-card .s-product-card-entry, .s-product-card-entry'
                )
                .forEach(function (card) {
                  pendingCards.add(card);
                });
            });
          });

          if (pendingCards.size) {
            scheduleCards();
          }
        });

      window.__velouraProductCardLiveObserver.observe(
        document.body,
        {
          childList: true,
          subtree: true
        }
      );
    }
  });

  document.addEventListener('theme::ready', function () {
    scanCards();
    setTimeout(scanCards, 500);
  });

  document.addEventListener(
    'salla-products-slider::products.fetched',
    scanCards
  );

  window.addEventListener(
    'resize',
    function () {
      window.requestAnimationFrame(scanCards);
    },
    { passive: true }
  );

})();
</script>












</body>
</html>

