<header
  class="store-header
  veloura-top-enabled
  {{ top_floating ? 'veloura-top-floating' : '' }}
  {{ top_compact_on_scroll ? 'veloura-top-compact-on-scroll' : '' }}
  {{ top_blur ? 'veloura-top-blur' : '' }}
  {{ top_logo_center ? 'veloura-top-logo-centered' : '' }}
  {{ top_logo_no_center_laptop ? 'veloura-top-logo-no-center-laptop' : '' }}
  {{ full_width_desktop ? 'veloura-top-full-width-desktop' : '' }}
  {{ search_detached ? 'veloura-top-search-detached' : '' }}
  {{ (not search_detached and desktop_search in ['bar', 'bar_sticky_icon']) ? 'veloura-header-balanced-search' : '' }}
  {{ hide_lang_desktop ? 'veloura-top-hide-lang-desktop' : '' }}
  {{ top_hide_on_scroll ? 'veloura-hide-top-on-scroll' : '' }}

  veloura-top-border-{{ top_border }}
  veloura-top-icons-{{ icons_size }}

  veloura-mobile-search-{{ mobile_search }}
  veloura-desktop-search-{{ desktop_search }}
  veloura-desktop-menu-{{ desktop_menu_mode }}
  "
  data-veloura-header="true"
  data-veloura-floating="{{ top_floating ? 'true' : 'false' }}"
  data-veloura-compact="{{ top_compact_on_scroll ? 'true' : 'false' }}"
  data-veloura-blur="{{ top_blur ? 'true' : 'false' }}"
  data-veloura-hide-scroll="{{ top_hide_on_scroll ? 'true' : 'false' }}"
  data-veloura-search-detached="{{ search_detached ? 'true' : 'false' }}"
  style="
    --veloura-top-bg: {{ top_bg }};
    --veloura-header-solid-bg: {{ top_bg }};
    --veloura-top-text: {{ top_text }};
    --veloura-top-cart-bg: {{ top_cart_bg }};
    --veloura-top-logo-size: {{ top_logo_size_px }}px;
  "
>
  <div id="mainnav" class="main-nav-container">
    <div class="inner w-full">
      <div class="veloura-header-container">
        <div class="veloura-header-grid">

          <div class="veloura-header__tools">
            <div class="veloura-header__actions">
            {# Desktop RTL visual order: account → cart → language/currency. #}
            <button type="button" class="veloura-header-icon veloura-login-btn" onclick="salla.event.dispatch('login::open')" aria-label="تسجيل الدخول">
              <i class="{{ top_login_icon }}"></i>
            </button>

            <salla-cart-summary class="veloura-header__cart veloura-cart-summary {{ hide_cart_total_mobile ? 'veloura-cart-hide-total veloura-cart-icon-only-mobile' : 'veloura-cart-total-visible' }}">
              <span slot="icon" class="veloura-cart-custom-icon">
                <i class="{{ top_cart_icon }}"></i>
              </span>
            </salla-cart-summary>

            {% if localization_available and not hide_lang_desktop %}
              <button type="button" class="veloura-header-icon veloura-lang-desktop veloura-localization-pill" data-veloura-localization-trigger aria-label="اللغة والعملة">
                <span class="veloura-localization-pill__language" data-veloura-language-label>{{ language.code == 'ar' ? 'العربية' : 'English' }}</span>
                <span class="veloura-localization-pill__divider" aria-hidden="true"></span>
                <span class="veloura-localization-pill__currency" data-veloura-currency-label></span>
              </button>
            {% endif %}

            {% if show_wishlist %}
              <a class="veloura-header-icon veloura-wishlist-btn" href="{{ store.url }}/wishlist" aria-label="المفضلة">
                <i class="sicon-heart"></i>
              </a>
            {% endif %}

            {% if dark_enabled and dark_toggle_enabled and dark_pos == 'left' %}
              <button type="button" class="veloura-header-icon veloura-dark-toggle" aria-label="تبديل الوضع الداكن">
                <i class="sicon-moon veloura-dark-toggle__icon"></i>
              </button>
            {% endif %}

            {% if desktop_search not in ['bar', 'bar_sticky_icon'] %}
              <button type="button" class="veloura-header-icon veloura-search-toggle" onclick="salla.event.dispatch('search::open')" aria-label="بحث">
                <i class="sicon-search"></i>
              </button>
            {% endif %}

            {% if dark_enabled and dark_toggle_enabled and dark_pos == 'right' %}
              <button type="button" class="veloura-header-icon veloura-dark-toggle" aria-label="تبديل الوضع الداكن">
                <i class="sicon-moon veloura-dark-toggle__icon"></i>
              </button>
            {% endif %}

            {% if show_mobile_lang and localization_available %}
              <button type="button" class="veloura-header-icon veloura-lang-mobile" data-veloura-localization-trigger aria-label="اللغة والعملة">
                <i class="sicon-earth"></i>
              </button>
            {% endif %}
            </div>

            <div class="veloura-header__menu">
              <a class="veloura-header-icon veloura-menu-trigger-mobile mburger mburger--collapse" href="#mobile-menu" aria-label="فتح القائمة">
                <i class="{{ top_menu_icon }}"></i>
              </a>
            </div>
          </div>

          <a class="navbar-brand veloura-header-logo" href="{{ store.url }}">
            {% if top_logo_is_video %}
              <video class="veloura-store-logo veloura-store-logo-video" src="{{ top_logo }}" autoplay muted loop playsinline data-light-logo="{{ top_logo }}" data-dark-logo="{{ theme.settings.get('veloura_dark_logo_2026') }}" aria-label="{{ store.name }} logo"></video>
            {% else %}
              <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ top_logo }}" data-light-logo="{{ top_logo }}" data-dark-logo="{{ theme.settings.get('veloura_dark_logo_2026') }}" class="veloura-store-logo" alt="{{ store.name }} logo">
            {% endif %}

            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          <div class="veloura-menu-links-wrap" data-veloura-desktop-menu-links>
            <custom-main-menu></custom-main-menu>
          </div>

          {% if not search_detached %}
            <div class="veloura-mobile-search-bar veloura-search-surface">
              <salla-search class="veloura-header-search-component" inline height="36"></salla-search>
            </div>

            <div class="veloura-desktop-search-bar veloura-search-surface">
              <salla-search class="veloura-header-search-component" inline height="36"></salla-search>
            </div>
          {% endif %}

        </div>
      </div>
    </div>
  </div>

  {% if localization_available %}
    <salla-localization-modal class="veloura-localization-modal-host"></salla-localization-modal>
  {% endif %}
</header>
