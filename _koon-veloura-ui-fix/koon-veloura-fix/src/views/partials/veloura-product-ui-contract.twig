  function observeDiscoveredRoots() {
    if (document.body) observeRoot(document.body);
    discoverRoots(document).forEach(function (root) {
      if (root !== document && root !== document.head && root !== document.body) observeRoot(root);
    });
  }

  function visible(element) {
    if (!element) return false;
    var style = getComputedStyle(element);
    return style.display !== 'none' && style.visibility !== 'hidden' && element.getClientRects().length > 0;
  }

  function exposeBetween(row, card) {
    var current = row.parentElement;
    while (current && current !== card) {
      important(current, 'overflow', 'visible');
      important(current, 'max-width', 'none');
      current = current.parentElement;
    }
  }

  function styleActionComponent(component, bg, fg, radius, height, id, depth) {
    if (!component || depth > 5) return;

    important(component, '--color-primary', bg);
    important(component, '--color-primary-reverse', fg);
    important(component, '--button-background-color', bg);
    important(component, '--button-border-color', bg);
    important(component, '--button-text-color', fg);
    important(component, '--salla-fast-checkout-button-border-radius', radius);
    important(component, 'display', 'block');
    important(component, 'width', '100%');
    important(component, 'max-width', '100%');
    important(component, 'min-width', '0');
    important(component, 'min-height', height);
    important(component, 'border-radius', radius);
    important(component, 'overflow', 'hidden');

    if (!component.shadowRoot) return;

    ensureShadowStyle(component.shadowRoot, id,
      ':host{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;' +
      'min-height:' + height + '!important;border-radius:' + radius + '!important;overflow:hidden!important;' +
      '--color-primary:' + bg + '!important;--color-primary-reverse:' + fg + '!important;' +
      '--button-background-color:' + bg + '!important;--button-border-color:' + bg + '!important;--button-text-color:' + fg + '!important}' +
      'button,.s-button-element,.s-button-btn,[part~="button"],.s-add-product-button-main{' +
      'width:100%!important;max-width:100%!important;min-width:0!important;min-height:' + height + '!important;' +
      'box-sizing:border-box!important;border-radius:' + radius + '!important;overflow:hidden!important}' +
      'button,.s-button-element,.s-button-btn,[part~="button"]{' +
      'display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;' +
      'background:' + bg + '!important;background-color:' + bg + '!important;border-color:' + bg + '!important;color:' + fg + '!important}' +
      'button *,.s-button-element *,.s-button-btn *{color:' + fg + '!important;fill:' + fg + '!important;stroke:currentColor!important}'
    );

    component.shadowRoot.querySelectorAll('salla-button,salla-quick-buy,salla-mini-checkout-widget,salla-add-product-button').forEach(function (child, index) {
      styleActionComponent(child, bg, fg, radius, height, id + '-' + index, depth + 1);
    });
  }

  function alignActionRow(card, row, x, bottom, isLast) {
    var cardRect = card.getBoundingClientRect();
    if (cardRect.width < 2) return;

    exposeBetween(row, card);
    row.classList.add('veloura-ui-card-action-row');

    var targetWidth = Math.max(0, cardRect.width - (x * 2));
    ['width', 'max-width', 'min-width', 'margin-left', 'margin-right', 'margin-inline', 'left', 'right', 'inset-inline', 'transform', 'align-self'].forEach(function (name) {
      row.style.removeProperty(name);
    });

    important(row, 'position', 'relative');
    important(row, 'width', targetWidth.toFixed(3) + 'px');
    important(row, 'max-width', targetWidth.toFixed(3) + 'px');
    important(row, 'min-width', '0px');
    important(row, 'margin-left', '0px');
    important(row, 'margin-right', '0px');
    important(row, 'align-self', 'flex-start');

    var rowRect = row.getBoundingClientRect();
    var deltaX = (cardRect.left + x) - rowRect.left;
    important(row, 'transform', 'translate3d(' + deltaX.toFixed(3) + 'px,0,0)');

    if (isLast) {
      var parent = row.parentElement;
      var parentRect = parent ? parent.getBoundingClientRect() : rowRect;
      var parentStyle = parent ? getComputedStyle(parent) : null;
      var innerParentBottom = parentRect.bottom - (parentStyle ? number(parentStyle.borderBottomWidth) + number(parentStyle.paddingBottom) : 0);
      var nativeBottomGap = Math.max(0, cardRect.bottom - innerParentBottom);
      important(row, 'margin-bottom', (bottom - nativeBottomGap).toFixed(3) + 'px');
    } else {
      important(row, 'margin-bottom', '0px');
    }
  }

  function syncCard(card) {
    if (!card || !card.querySelectorAll) return;
    var x = Math.max(0, number(cssValue('--veloura-ui-card-action-x', '0px')));
    var bottom = Math.max(0, number(cssValue('--veloura-ui-card-action-bottom', '0px')));
    var radius = cssValue('--veloura-ui-card-button-radius', '16px');
    var height = cssValue('--veloura-ui-card-button-height', '42px');
    var bg = cssValue('--veloura-ui-card-button-bg', '#004d65');
    var fg = cssValue('--veloura-ui-card-button-text', '#ffffff');
    var rows = Array.prototype.filter.call(card.querySelectorAll(ACTION_SELECTORS), visible);

    rows.forEach(function (row, index) {
      alignActionRow(card, row, x, bottom, index === rows.length - 1);
      row.querySelectorAll('salla-add-product-button').forEach(function (button, buttonIndex) {
        button.setAttribute('width', 'wide');
        try { button.width = 'wide'; } catch (error) {}
        styleActionComponent(button, bg, fg, radius, height, 'veloura-ui-card-button-' + buttonIndex, 0);
      });
    });

    if (resizeObserver && !resizedCards.has(card)) {
      resizedCards.add(card);
      resizeObserver.observe(card);
    }
  }

  function syncCards() {
    deepAll('.s-product-card-entry', document).forEach(syncCard);
  }

  function syncQuickView() {
    var buttonRadius = cssValue('--veloura-ui-qv-button-radius', '999px');
    var modalRadius = cssValue('--veloura-ui-qv-modal-radius', '28px');
    deepAll('.veloura-quick-view-modal__dialog,.veloura-qv-full__dialog', document).forEach(function (dialog) {
      important(dialog, 'border-radius', modalRadius);
      important(dialog, 'overflow', 'hidden');
    });
    deepAll('.veloura-quick-view-modal__media,.veloura-quick-view-modal__content,.veloura-qv-full__media,.veloura-qv-full__content', document).forEach(function (node) {
      important(node, 'border-radius', modalRadius);
    });
    deepAll('.veloura-quick-view-modal__close,.veloura-quick-view-modal__link,.veloura-qv-full__close,.veloura-qv-full__circle,.veloura-qv-full__add,.veloura-qv-full__read-more,.veloura-quick-view-btn,.veloura-pc-native-quick', document).forEach(function (node) {
      important(node, 'border-radius', buttonRadius);
    });
  }

  function syncPurchaseBar() {
    var page = document.querySelector('.veloura-product-page');
    var bar = page && page.querySelector('.veloura-product-sticky-bar');
    if (!bar) return;

    var radius = cssValue('--veloura-ui-product-radius', '28px');
    var root = rootStyle();
    var primary = root.getPropertyValue('--color-primary').trim() || '#004d65';
    var primaryText = root.getPropertyValue('--color-primary-reverse').trim() || '#ffffff';
    important(bar, 'border-radius', radius);

    var host = bar.querySelector('salla-add-product-button');
    if (!host) return;
    important(host, 'border-radius', radius);
    important(host, '--salla-fast-checkout-button-border-radius', radius);

    if (!host.shadowRoot) return;
    ensureShadowStyle(host.shadowRoot, 'veloura-ui-purchase-host',
      ':host{display:block!important;width:100%!important;max-width:100%!important;border-radius:' + radius + '!important}' +
      '.s-add-product-button-main{display:flex!important;width:100%!important;max-width:100%!important;gap:12px!important}' +
      'salla-button,salla-quick-buy,salla-mini-checkout-widget{flex:1 1 0!important;min-width:0!important;border-radius:' + radius + '!important;overflow:hidden!important}'
    );
    host.shadowRoot.querySelectorAll('salla-button,salla-quick-buy,salla-mini-checkout-widget').forEach(function (action, index) {
      styleActionComponent(action, primary, primaryText, radius, '46px', 'veloura-ui-purchase-action-' + index, 0);
    });
  }

  function syncAll() {
    ensureStyleLast();
    observeDiscoveredRoots();
    syncCards();
    syncQuickView();
    syncPurchaseBar();
  }

  function start() {
    syncAll();
    [60, 180, 420, 900, 1600, 2800, 4500, 7000].forEach(function (delay) {
      setTimeout(syncAll, delay);
    });

    clearInterval(pollTimer);
    pollTimer = setInterval(function () {
      pollCount += 1;
      syncAll();
      if (pollCount >= 20) clearInterval(pollTimer);
    }, 500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
  else start();

  document.addEventListener('theme::ready', schedule);
  document.addEventListener('salla::products::loaded', schedule);
  document.addEventListener('salla::product.cards::loaded', schedule);
  document.addEventListener('salla::product::details::loaded', schedule);
  document.addEventListener('afterInit', schedule);
  window.addEventListener('pageshow', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
})();
</script>
