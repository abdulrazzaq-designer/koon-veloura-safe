    <style>
      :root {
        --font-main: '{{ theme.font.name }}';
        --color-primary: {{ theme.color.primary }};
        --color-primary-dark: {{ theme.color.darker(0.15) }};
        --color-primary-light: {{ theme.color.lighter(0.15) }};
        --color-primary-reverse: {{ theme.color.reverse_text }};

        --veloura-dark-body-bg: {{ theme.settings.get('veloura_dark_body_bg_2026', '#010202') }};
        --veloura-dark-secondary-bg: {{ theme.settings.get('veloura_dark_secondary_bg_2026', '#010612') }};
        --veloura-dark-primary-text: {{ theme.settings.get('veloura_dark_primary_text_2026', '#ffffff') }};
        --veloura-dark-secondary-text: {{ theme.settings.get('veloura_dark_secondary_text_2026', '#ededed') }};
        --veloura-dark-product-card-bg: {{ theme.settings.get('veloura_dark_product_card_bg_2026', '#111111') }};
        --veloura-dark-product-card-text: {{ theme.settings.get('veloura_dark_product_card_text_2026', '#ffffff') }};
        --veloura-dark-product-card-border: {{ theme.settings.get('veloura_dark_product_card_border_2026', '#111111') }};

        --veloura-top-bg: {{ theme.settings.get('veloura_top_bg_color_2026', '#ffffff') }};
        --veloura-top-text: {{ theme.settings.get('veloura_top_text_color_2026', '#004d65') }};
        --veloura-top-cart-bg: {{ theme.settings.get('veloura_top_cart_bg_2026', '#f87171') }};
        --veloura-top-logo-size: {{ 42 + theme.settings.get('veloura_top_logo_size_2026', 20) * 3 }}px;

        --veloura-site-bg: {{ veloura_site_bg }};
        --veloura-site-second-bg: {{ veloura_site_second_bg }};
        --veloura-site-spacing: {{ veloura_site_spacing }}px;
        --veloura-site-container-width: {{ veloura_container_width }}px;
        --veloura-shell-gap: 12px;

        {% if veloura_should_show_bg_image %}
          --veloura-site-bg-image: url('{{ veloura_site_bg_image }}');
        {% endif %}

        {% if vpc_enabled %}
